# Copy this file to .env and fill in real values. Never commit .env.
#
# Endpoint:  az cognitiveservices account show -n automate-ta-openai -g rg-automate-ta --query properties.endpoint -o tsv
# Key:       az cognitiveservices account keys list -n automate-ta-openai -g rg-automate-ta --query key1 -o tsv

AZURE_OPENAI_ENDPOINT=https://automate-ta-openai.openai.azure.com/
AZURE_OPENAI_KEY=your-key-here
AZURE_OPENAI_DEPLOYMENT=constraint-parser
